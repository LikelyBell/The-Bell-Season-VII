---
import '../style/main.css';
---
<style>
    header {
        background-color: var(--sidebar-color);
        color: var(--sidebar-text-color);
        margin:10px 0px;
        padding-left:10px;
        overflow:auto;
        display:flex;
        flex-flow: row wrap;
        align-items: center;
        gap:10px;
        height:fit-content;
    }

    header nav {
        display:flex;
        flex-flow: row wrap;
        align-items: center;
        gap:10px;
        height:100%;
    }
    
    header a {
        display:flex;
        background-color: var(--link-color);
        color: var(--background-color);
        padding: 1rem 10px;
        min-width: 5rem;
        justify-content:center;
        align-items:center;
        &:visited {
            background-color: var(--visited-color);
            color: var(--background-color);
        }
    }
</style>
<header>
    <h1 id="headerTitle">The Bell Season VII</h1>
    <nav>
        <a href="/">Home</a>
        <a href="/404">404</a>
    </nav>
</header>
